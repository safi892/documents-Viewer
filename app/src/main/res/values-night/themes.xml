<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark palette twin of values/themes.xml: the pre-composition frame is
         off-black, and the system bar icons flip to light. -->
    <style name="Theme.Reader" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
